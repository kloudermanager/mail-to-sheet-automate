ADMIN_USER=admin
ADMIN_PASS=change-me
SHEET_ID=your-google-sheet-id
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REFRESH_TOKEN=paste-the-value-from-get-refresh-token.js

# Comma-separated list of trusted supplier domains (or full addresses). Only
# mail matching one of these is ever scanned. Each domain auto-derives a tab
# name (vertexsms.com -> "Vertexsms"); add "=Custom Name" after any entry to
# override that name instead, e.g. vertexsms.com=Vertex SMS. If no tab with
# that name exists yet in your sheet, one is created automatically with the
# correct headers; if it already exists, new rows are appended there.
GMAIL_SENDER_MAP=vertexsms.com,naliaglobal.net,broadnetme.com,aetelco.com,bbtvoice.com,chat-link.net,globeteleservices.com,aladincomm.com,lms.net,cmi.chinamobile.com,mobeep.io,next-page.net,saarctel.net,paasoo.com,tokydigital.it

# Optional: only needed if you want it to also read rate tables pasted directly
# into an email body (not just Excel/CSV attachments). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Leave false while you're testing — changes wait in the "Pending Review" tab
# for you to approve at the app's URL. Set to true once you trust it fully.
AUTO_APPLY_EMAIL_UPDATES=false

PORT=3000
